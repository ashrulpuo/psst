{
  "name": "psst-client",
  "version": "0.0.1",
  "private": true,
  "description": "A Quasar Project",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Claude <noreply@anthropic.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "e2e": "node e2e/smoke.mjs",
    "e2e:realtime": "node e2e/realtime.mjs",
    "dev:pwa": "quasar dev -m pwa",
    "build:pwa": "quasar build -m pwa",
    "e2e:push": "node e2e/push.mjs",
    "e2e:native": "node e2e/native.mjs",
    "build:android": "quasar build -m capacitor -T android",
    "build:ios": "quasar build -m capacitor -T ios",
    "build:desktop": "quasar build -m electron",
    "e2e:desktop": "xvfb-run -a node e2e/desktop.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.59.0",
    "@quasar/extras": "^2.1.0",
    "laravel-echo": "^2.6.1",
    "pinia": "^4.0.2",
    "pusher-js": "^8.6.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.4",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Psst"
}
