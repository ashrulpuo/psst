# Copy to `.env` and fill in what you have. Everything here is public at build time — OAuth client IDs
# are not secrets. The server keeps the matching allow-lists (GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS).

# Local sign-in shortcut: renders the demo accounts (alice / bob / carol) on /login.
# The API must also have PSST_DEV_LOGIN=true. Never enable this in production.
QCLI_DEV_LOGIN=true

# Public Reverb app key. Empty = realtime off, the app falls back to polling.
QCLI_REVERB_KEY=

# Google sign-in. The button only appears when this is set; Google draws it itself.
# Create an OAuth client ID (Web application) with http://localhost:9000 as an authorised origin.
QCLI_GOOGLE_CLIENT_ID=
# iOS OAuth client ID for the native app (Android uses the web ID above).
QCLI_GOOGLE_IOS_CLIENT_ID=

# Apple sign-in. Needs a Services ID + key from the Apple Developer portal, and an https return URL —
# Apple will not redirect to plain localhost, so this stays empty for local development.
QCLI_APPLE_CLIENT_ID=
QCLI_APPLE_REDIRECT_URI=

# Where the UI talks to the API when they are not same-origin (the native apps). Empty for the web.
QCLI_API_URL=
# Public https origin of the deployment; shared links and app links are built from it.
QCLI_PUBLIC_URL=

# Cloudflare Turnstile site key for guest sends. Empty = challenge off.
QCLI_TURNSTILE_SITE_KEY=

# Only for the iOS simulator, which cannot reach the host machine by name.
QCLI_NATIVE_SIMULATOR=
