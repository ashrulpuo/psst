{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}

	# Realtime: browsers connect to /app on 443; Reverb itself stays on the Docker network.
	# Inside handle: a bare reverse_proxy sorts after handle, so the SPA catch-all below would swallow it.
	@ws path /app/*
	handle @ws {
		reverse_proxy reverb:8080
	}

	# Link previews: social crawlers asking for /{username} get a small HTML page (username only, noindex) from Laravel.
	# Real people never see it: the matcher needs a crawler User-Agent, and a browser that requests /preview/* directly
	# falls through to the SPA catch-all below (the app's own not-found page), because only crawler requests for
	# /{username} are rewritten.
	# Instagram and Threads are deliberately not in the list: their in-app browsers send "Instagram" in the User-Agent,
	# so real people opening a shared link there would get the preview instead of the app. Meta fetches those previews
	# as facebookexternalhit / meta-externalagent, which are listed.
	# The exclusions are real static files and SPA routes that also look like usernames; the username rule is the
	# same as SetUsernameRequest and the API routes. Reserved names (terms, admin, ...) that are not excluded here
	# are rewritten but 404 in PHP via psst.reserved_usernames, so they never produce a preview.
	@preview {
		header_regexp ua User-Agent (?i)(facebookexternalhit|meta-externalagent|Twitterbot|Slackbot|WhatsApp|TelegramBot|LinkedInBot|Discordbot|Googlebot|bingbot)
		path_regexp user ^/([a-z0-9_.]{3,24})$
		not path /login /terms /privacy /welcome /link /inbox /sent /settings /admin /api /app /sanctum /og.png /sw.js /manifest.json /index.html /favicon.ico /robots.txt /sitemap.xml
	}
	handle @preview {
		rewrite * /preview/{re.user.1}
		root * /var/www/html/public
		php_fastcgi app:9000 {
			resolve_root_symlink
			# FastCGI reports the ORIGINAL request URI to PHP, so Laravel would route /alice, not /preview/alice.
			env REQUEST_URI /preview/{re.user.1}
		}
	}

	# API, CSRF cookie and health check go to Laravel.
	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		root * /var/www/html/public
		php_fastcgi app:9000 {
			resolve_root_symlink
		}
	}

	# App-link verification for the native apps. Must be served as-is (no redirects) with a JSON content type.
	@appLinks path /.well-known/assetlinks.json /.well-known/apple-app-site-association
	handle @appLinks {
		root * /srv/wellknown
		header Content-Type "application/json"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Admin app (built with base /admin/). Same origin as the API so the session cookie is shared.
	# To restrict it to a network, add before file_server:  @blocked not remote_ip 203.0.113.0/24
	#                                                      respond @blocked 404
	handle /admin/* {
		root * /srv/admin
		# Hashed assets never change; the HTML shell names them, so it must never be cached.
		@adminAssets path /admin/assets/*
		@adminShell not path /admin/assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		header @adminShell Cache-Control "no-store"
		try_files {path} /admin/index.html
		file_server
	}

	# Everything else is the public app (Quasar PWA) with single-page-app fallback.
	handle {
		root * /srv/client
		@immutable path /assets/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /manifest.json /index.html
		header @fresh Cache-Control "no-cache"
		# Profile pages (/{username}) must not be indexed; home, /terms and /privacy stay indexable.
		@profile {
			path_regexp ^/[a-z0-9_.]{3,24}$
			not path /login /terms /privacy /welcome /link /inbox /sent /settings /og.png /sw.js /manifest.json /index.html /favicon.ico /robots.txt /sitemap.xml
		}
		header @profile X-Robots-Tag "noindex, nofollow"
		try_files {path} /index.html
		file_server
	}
}
