{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}

	# Realtime: browsers connect to /app on 443; Reverb itself stays on the Docker network.
	@ws path /app/*
	reverse_proxy @ws reverb:8080

	# API, CSRF cookie and health check go to Laravel.
	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		root * /var/www/html/public
		php_fastcgi app:9000 {
			resolve_root_symlink
		}
	}

	# App-link verification for the native apps. Must be served as-is (no redirects) with a JSON content type.
	handle /.well-known/assetlinks.json /.well-known/apple-app-site-association {
		root * /srv/wellknown
		header Content-Type "application/json"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Admin app (built with base /admin/). Same origin as the API so the session cookie is shared.
	# To restrict it to a network, add before file_server:  @blocked not remote_ip 203.0.113.0/24
	#                                                      respond @blocked 404
	handle /admin/* {
		root * /srv/admin
		# Hashed assets never change; the HTML shell names them, so it must never be cached.
		@adminAssets path /admin/assets/*
		@adminShell not path /admin/assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		header @adminShell Cache-Control "no-store"
		try_files {path} /admin/index.html
		file_server
	}

	# Everything else is the public app (Quasar PWA) with single-page-app fallback.
	handle {
		root * /srv/client
		@immutable path /assets/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /manifest.json /index.html
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
