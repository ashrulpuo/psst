APP_DOMAIN=psst.example.com
ACME_EMAIL=you@example.com
APP_TAG=local

APP_NAME=Psst
APP_ENV=production
APP_DEBUG=false
APP_URL=https://psst.example.com
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psst
DB_USERNAME=psst
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Realtime. Generate with `php artisan reverb:install` and keep the secret private.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-Reverb traffic stays on the Docker network; browsers reach Reverb through Caddy at /app on 443.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=psst.example.com

# Nightly encrypted database backup (php artisan psst:backup, 03:00). Any S3-compatible bucket.
# Losing the passphrase makes every backup unreadable: keep a copy outside this server.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Sign-in. Comma-separated OAuth client IDs. Empty = every Google sign-in is rejected (nobody can log in).
GOOGLE_CLIENT_IDS=
# Required only if Apple sign-in is offered; empty = Apple sign-in is rejected.
APPLE_CLIENT_IDS=

# Browser origins allowed to call the API. Missing = native apps and the web app get CORS errors.
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,https://psst.example.com
# Hosts that may use cookie auth. Missing = cookie sign-in (admin app) fails.
SANCTUM_STATEFUL_DOMAINS=psst.example.com

# Never true in production. If true, demo accounts become a login bypass.
PSST_DEV_LOGIN=false

# Web Push, generate with `php artisan psst:vapid`. Empty = push notifications stay off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudflare Turnstile secret for guest sends. Empty = no challenge, guests are only rate-limited.
TURNSTILE_SECRET=

# Guest send levers. Changing any of these needs: docker compose up -d --force-recreate app
# (and php artisan config:cache if config is cached). PSST_GUEST_SENDS=false pauses anonymous sending (503);
# signed-in senders are unaffected. The numbers below are today's defaults.
PSST_GUEST_SENDS=true
PSST_GUEST_PER_IP_MINUTE=4
PSST_GUEST_PER_IP_HOUR=30
PSST_GUEST_PER_TOKEN_MINUTE=3
PSST_GUEST_PER_TARGET_HOUR=200
PSST_USER_PER_MINUTE=20
PSST_USER_PER_DAY=300

# Owner alert: emailed (no message text) when an inbound message is flagged. Empty = no email.
# Needs working mail below; the default MAIL_MAILER=log only writes to the log.
ADMIN_ALERT_EMAIL=
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Backup bucket region. Leave `auto` unless your S3 provider needs a real region.
BACKUP_S3_REGION=auto

# Error tracking (Sentry free tier). Leave empty to disable: nothing is sent without a DSN.
# Events are scrubbed in app/Observability/ScrubEvent.php: no message bodies, tokens, cookies, IPs or request data.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
