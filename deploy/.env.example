APP_DOMAIN=psst.example.com
ACME_EMAIL=you@example.com
APP_TAG=local

APP_NAME=Psst
APP_ENV=production
APP_DEBUG=false
APP_URL=https://psst.example.com
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psst
DB_USERNAME=psst
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Realtime. Generate with `php artisan reverb:install` and keep the secret private.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-Reverb traffic stays on the Docker network; browsers reach Reverb through Caddy at /app on 443.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=psst.example.com
